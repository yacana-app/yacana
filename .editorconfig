root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# The same style as Android Studio's formatter, so the IDE and ktlint agree.
ktlint_code_style = intellij_idea
max_line_length = 140
# Composable functions are named like types.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
